# Copy this file to .env and fill in local values. Never commit .env.

# Neon serverless Postgres connection string.
# Get this from the Neon console (Project -> Connection Details).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# LALAL.ai API key for real stem splitting.
LALAL_API_KEY=REPLACE_WITH_LALAL_API_KEY

# Optional shared secret for audio2chart requests.
AUDIO2CHART_TOKEN=REPLACE_WITH_AUDIO2CHART_TOKEN

# Quality metrics are persisted in the Postgres DB above (DATABASE_URL) so they
# survive restarts; no extra service needed. Optionally override the row key:
# METRICS_DB_KEY=global

# Song identification (Shazam, via the open-source ShazamIO client). Optional: without
# `pip install shazamio` the conversion still works and uses the defaults (file name as
# title, artist "Dolly"). Point SHAZAM_PYTHON at the interpreter that has shazamio installed.
# SHAZAM_PYTHON=python3
# SONG_IDENTIFY=off   # disable identification entirely
